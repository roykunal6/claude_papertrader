# Copy this file to .env and fill it in. Never share .env.

# Option A (simplest): paste today's access token from indstocks.com > API Trading > Access tokens
INDSTOCKS_ACCESS_TOKEN=

# Option B (automatic daily login): leave the token empty and fill these in
INDSTOCKS_CLIENT_ID=
INDSTOCKS_MPIN=
INDSTOCKS_TOTP_SECRET=
